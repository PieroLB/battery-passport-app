# Copy to .env and fill in. Dummy values only — never commit real secrets.
NODE_ENV=development
API_PORT=4000
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword
JWT_SECRET=change-me-to-a-random-string-of-32-chars-min
JWT_EXPIRES_IN=8h
PUBLIC_BASE_URL=http://localhost:3000
ARCHIVE_DIR=./.data/archives
ARCHIVE_BACKUP_DIR=./.data/backup
SEED_DEFAULT_PASSWORD=demo-password
REUSE_MIN_SOH_PERCENT=70
REUSE_MAX_RESISTANCE_FACTOR=1.0
ARCHIVE_REQUIRES_OWNER_VALIDATION=true

# Production only (compose prod / Caddy)
DOMAIN=bp.example.com
GHCR_OWNER=pierolb
IMAGE_TAG=latest
